<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- The Windows SDK version is needed for the media controls API (Windows.Media.Control). -->
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- For UI Automation (System.Windows.Automation), used to read and set ratings in Apple Music. -->
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>iTunesLogo.ico</ApplicationIcon>
    <IsPublishable>False</IsPublishable>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="iTunesLogo.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\iTunesControllerLib\iTunesControllerLib.csproj" />
  </ItemGroup>

</Project>
